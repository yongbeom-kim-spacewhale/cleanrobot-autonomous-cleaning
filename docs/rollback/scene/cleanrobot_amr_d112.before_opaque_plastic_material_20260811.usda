                over "rear_lidar_publish_scan"
                {
                    string inputs:topicName = "/cobot3/rear/scan_unfiltered"
                }

                over "publish_robot_transform_tree" (
                    active = true
                )
                {
                    rel inputs:parentPrim = </World/CleanRobot/chassis_link>
                    bool inputs:staticPublisher = 0
                    rel inputs:targetPrims = [
                        </World/CleanRobot/chassis_link>,
                        </World/CleanRobot/chassis_link/ProjectSensors/FrontD455/RSD455/Camera_Pseudo_Depth/cobot3_amr_camera_optical_frame>,
                        </World/CleanRobot/chassis_link/sensors/front_RPLidar/RPLidar_S2E/front_lidar_link>,
