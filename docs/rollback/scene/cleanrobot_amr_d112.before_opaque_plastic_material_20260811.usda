                over "publish_odometry"
                {
                    string inputs:chassisFrameId = "tf_amr"
                    string inputs:odomFrameId = "odom"
                }

                over "publish_odom_to_base_link"
                {
                    string inputs:childFrameId = "tf_amr"
                    string inputs:parentFrameId = "odom"
                }

                over "publish_tf_amr_to_chassis" (
                    active = true
                )
                {
                    string inputs:childFrameId = "chassis_link"
                    string inputs:parentFrameId = "tf_amr"
                    quatd inputs:rotation = (1, 0, 0, 0)
                    bool inputs:staticPublisher = 1
                    string inputs:topicName = "/tf_static"
                    double3 inputs:translation = (0, 0, 0)
                }

                over "publish_base_to_tf_robotarm" (
                    active = true
                )
                {
                    string inputs:childFrameId = "tf_robotarm"
                    string inputs:parentFrameId = "base_link"
                    quatd inputs:rotation = (1, 0, 0, 0)
                    bool inputs:staticPublisher = 1
                    string inputs:topicName = "/tf_static"
                    double3 inputs:translation = (0, 0, 0)
                }

                over "compute_odometry"
                {
                    rel inputs:chassisPrim = </World/CleanRobot/chassis_link>
                }

                over "differential_controller"
                {
                    double inputs:maxAngularSpeed = 0.6
                    double inputs:maxLinearSpeed = 0.7
                    double inputs:wheelDistance = 0.4132
                    double inputs:wheelRadius = 0.14
                }

