                        </World/CleanRobot/Manipulator/M0609/Gripper/angle_bracket/WristD455/RSD455/Camera_Pseudo_Depth/cobot3_wrist_depth_optical_frame>,
                        </World/CleanRobot/Manipulator/M0609/Gripper/angle_bracket/grasp_tcp>,
                    ]
                    string inputs:topicName = "/tf"
                }

                over "publish_chassis_sensor_transform_tree" (
                    active = false
                )
                {
                }

                over "publish_wrist_camera_transform_tree" (
                    active = false
                )
                {
                }
            }

            over "Lidar3DGraph"
            {
                over "ros2_context"
                {
                    uchar inputs:domain_id = 112
                    bool inputs:useDomainIDEnvVar = 0
                }
            }

